# Ollama (local AI — run `ollama serve` and `ollama pull qwen3.5:4b` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Ollama web search API key — get one at https://ollama.com/settings/keys
# Leave blank to disable web search (AI will still use DB articles + training data)
OLLAMA_API_KEY=

DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
