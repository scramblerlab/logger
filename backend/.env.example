# Ollama (local AI — run `ollama serve` and `ollama pull qwen3.5:4b` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Ollama web search API key — get one at https://ollama.com/settings/keys
# Leave blank to disable web search (AI will still use DB articles + training data)
OLLAMA_API_KEY=

DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://extensions.shopifycdn.com

# JWT secret — used for editor login and shared storage token signing
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# Shared Storage API token — generate once with:
#   python -c "from dotenv import load_dotenv; load_dotenv(); import os; from jose import jwt; print(jwt.encode({'type': 'shared_storage', 'iss': 'scrambler-lab'}, os.environ['JWT_SECRET'], algorithm='HS256'))"
# Copy the output here. The server must be restarted after adding this value.
SHARED_STORAGE_TOKEN=
